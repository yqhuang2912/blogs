{
  "name": "scientific-spaces-blog",
  "private": true,
  "version": "0.1.0",
  "description": "Static blog front-end assets",
  "scripts": {
    "generate:posts": "node scripts/generate-post-manifest.js",
    "create:post": "node scripts/create-post-from-markdown.js",
    "post": "node scripts/manage-posts.js",
    "posts:list": "node scripts/manage-posts.js --list",
    "check": "node tests/security.test.js && node tests/ui.test.js && node tests/manager.test.js && node scripts/check-site.js",
    "build": "node scripts/build-site.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  }
}
